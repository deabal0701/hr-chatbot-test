    "    return decision\n",
    "\n",
    "# ?먮윭 ?몃뱾??n",
    "def handle_error_node(state: NL2SQLState) -> NL2SQLState:\n",
    "    \"\"\"?먮윭 泥섎━ ?몃뱶\"\"\"\n",
