    "# 議곌굔遺 ?ｌ? ?⑥닔\n",
    "def should_execute(state: NL2SQLState) -> str:\n",
    "    \"\"\"寃利??깃났 ??execute, ?ㅽ뙣 ??error\"\"\"\n",
